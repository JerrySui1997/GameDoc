{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "--turbopack", "-p", "3140"],
      "port": 3140
    },
    {
      "name": "collab",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:collab"],
      "port": 1234
    },
    {
      "name": "prod",
      "runtimeExecutable": "node",
      "runtimeArgs": ["dist/server.js"],
      "port": 3000
    },
    {
      "name": "dev:all",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:all"],
      "port": 3000
    }
  ]
}

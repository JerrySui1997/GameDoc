# Normalize line endings: store LF in the repo, check out LF everywhere.
# Keeps Windows dev and Ubuntu CI from producing line-ending churn / noisy diffs.
* text=auto eol=lf

# Treat common binary assets as binary (never normalize).
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary

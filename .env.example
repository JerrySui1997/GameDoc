# Copy to .env.local and adjust as needed.

# WebSocket URL the browser uses to reach the Yjs collab relay.
# This is a build-time NEXT_PUBLIC_* var — it is inlined at build, so each
# environment must be BUILT with its own value (rebuild after changing it).
# Local dev default (used automatically if unset): ws://localhost:1234
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234

# ── Collab relay process (server/collab.ts) — optional overrides ────────────
# HOST=0.0.0.0
# COLLAB_PORT=1234
# COLLAB_DB_DIR=~/.gamedoc/collab-db

# Copy to .env.local and adjust as needed.

# WebSocket URL the browser uses to reach the Yjs collab relay.
# Build-time NEXT_PUBLIC_* var (inlined at build). Browser precedence:
#   1. this value if set   2. same-origin /collab (production merged server)
#   3. ws://localhost:1234 (dev fallback when unset)
# For local dev with the standalone relay, keep the localhost value:
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234

# ── Collab relay process (server/collab.ts) — optional overrides ────────────
# HOST=0.0.0.0
# COLLAB_PORT=1234
# COLLAB_DB_DIR=~/.gamedoc/collab-db

# ── Production data (server/index.ts) ───────────────────────────────────────
# Root for the runtime-mutable JSON collections (docs/collections/templates).
# Defaults to the in-repo src/data; point it at a persistent volume in prod.
# DATA_DIR=/data
# COLLAB_DB_DIR=/data/collab-db

# ── Site-wide password gate (src/lib/auth/session.ts) ───────────────────────
# Unset by default (no gate). Set both to enable — SITE_PASSWORD is the shared
# password; AUTH_SECRET seeds the session-cookie HMAC (falls back to
# SITE_PASSWORD itself if unset, so setting it separately just rotates the
# cookie independently of the password).
# SITE_PASSWORD=
# AUTH_SECRET=

# ── Agent write auth (src/lib/auth/agentToken.ts) ───────────────────────────
# Shared secret required on the doc-mutation REST routes (POST/PUT/PATCH/DELETE
# under /api/docs, POST /api/agent/events) once set — unset means those routes
# stay open, matching today's behavior. This is what lets the "gamedoc-live"
# MCP registration (see mcp/README.md) write to a deployed instance without
# opening it to anyone with the URL. GET routes are never gated. It also lets
# the gamedoc-live MCP bypass the site-wide password gate above on /api/* via
# a Bearer token instead of a browser session cookie (see src/middleware.ts).
# Set the same value here (server-side) and in the shell that launches Claude
# Code, so gamedoc-live's ${GAMEDOC_AGENT_TOKEN} expansion in .mcp.json matches.
# GAMEDOC_AGENT_TOKEN=

# ── Per-user accounts (src/auth.ts / src/auth.config.ts) ────────────────────
# Auth.js JWT signing secret. Deliberately a different name from AUTH_SECRET
# above (the legacy gate's var) — both configs pass this explicitly so
# Auth.js never falls back to reading AUTH_SECRET itself. Generate with:
# npx auth secret
# GAMEDOC_ACCOUNTS_SECRET=

# REQUIRED in production (Railway), unlike everything else in this section.
# Auth.js only trusts the request's Host/X-Forwarded-* headers when AUTH_URL,
# AUTH_TRUST_HOST, VERCEL, or CF_PAGES is set, or NODE_ENV !== 'production'
# (see node_modules/@auth/core/lib/utils/env.js). Railway matches none of
# those, so every /api/auth/* request 500s with an UntrustedHost error until
# this is set to the app's real origin, e.g.:
# AUTH_URL=https://gamedoc-production.up.railway.app

# Google/GitHub OAuth app credentials. Callback URLs to register:
#   {origin}/api/auth/callback/google
#   {origin}/api/auth/callback/github
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# SMTP creds for magic-link email sign-in (next-auth/providers/nodemailer).
# Unset in dev: the magic-link URL logs to the server console instead.
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM="GameDoc <no-reply@example.com>"

# SQLite file for accounts/sessions (Drizzle). Defaults outside the project
# root (~/.gamedoc/auth.db) — same reasoning as COLLAB_DB_DIR above: WAL
# mode's -wal/-shm sidecar files churn on every write, and Turbopack's dev
# watcher has already panicked once on an embedded DB's lock file living
# inside the watched tree. Point this at the mounted volume in prod.
# AUTH_DB_PATH=/data/auth.db
